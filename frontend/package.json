{
  "name": "aemotional-line-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "types": "openapi-typescript openapi.json --output src/api/schema.d.ts",
    "dev": "npm run types && vite",
    "check": "npm run types && tsc --build && eslint . && vitest run",
    "test": "npm run types && vitest run",
    "build": "npm run types && vite build",
    "e2e": "npm run build && cd .. && ./mvnw -q -DskipTests -Dskip.installnodenpm -Dskip.npm package && cd frontend && playwright test"
  },
  "dependencies": {
    "bootstrap": "5.3.8",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-bootstrap": "2.10.10",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
